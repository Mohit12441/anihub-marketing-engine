# AniHub Stream Marketing Engine - Environment Configuration

# Execution Mode
DRY_RUN=True
LOG_LEVEL=INFO

# Website & Attribution
SITE_BASE_URL=https://anihubstream.com
SITE_NAME=AniHub Stream

# Instagram Graph API (Meta for Developers)
# Requires an Instagram Professional/Creator account connected to a Facebook Page
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_meta_access_token

# Twitter / X API v2 (Developer Portal)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Image Staging (Meta Graph API requires public HTTPS image URLs)
# Free Imgur client ID or Cloudinary URL
IMGUR_CLIENT_ID=your_imgur_client_id
# or CLOUDINARY_URL=cloudinary://key:secret@cloudname

# Monitoring & Webhooks (Optional but recommended)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
